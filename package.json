{
  "name": "ccai",
  "version": "0.1.0",
  "private": true,
  "description": "FiveStrata AI call center platform — VICIdial + Telnyx + Supabase",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "snowflake:check": "tsx scripts/snowflake-check.ts",
    "snowflake:sync": "tsx scripts/snowflake-sync.ts",
    "snowflake:discover": "tsx scripts/snowflake-discover.ts",
    "inbound:seed": "tsx scripts/inbound-key-seed.ts",
    "inbound:test": "tsx scripts/inbound-test.ts",
    "inbound:deploy": "tsx scripts/deploy-webhook.ts fivestrata-inbound",
    "outbound:test": "tsx scripts/outbound-test.ts",
    "dispo:drain": "tsx scripts/dispo-drain.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "snowflake-sdk": "^3.1.0",
    "telnyx": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
