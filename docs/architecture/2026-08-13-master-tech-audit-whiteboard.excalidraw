      "type": "text",
      "x": 2179.7906006845938,
      "y": 197.6596978164135,
      "width": 739.1395263671875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
